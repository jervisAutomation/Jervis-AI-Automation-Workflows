{
  "name": "ai-email-assistant-workflow",
  "nodes": [
    {
      "parameters": {
        "model": "openai/gpt-oss-20b",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [
        856,
        568
      ],
      "id": "0b384666-7ecc-4ef2-8413-0de340116dd2",
      "name": "Groq Chat Model"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a helpful email assistant. Your job is to read incoming emails, summarize them in one line, and decide whether they need a reply. If a reply is needed, you will draft a polite response based on the email content. Always draft the response in th HTML format so that it is ready to be sent.",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "type": "HumanMessagePromptTemplate",
              "message": "=Your Tasks:\n1. Summarize the email given below in one line.\n2. Tell me if a reply is needed (Yes/No).\n3. If yes, suggest short and polite reply I can send.\n\nPlease respond in the following JSON format:\n{\n  \"Email subject\": {{ $json.headers.subject }},\n  \"Email thread id\": {{ $json.threadId }},\n  \"Sender\": {{ $json.to.value[0].address }},\n  \"summary\": \"One sentence summary of the email\",\n  \"reply_needed\": \"Yes or No\",\n  \"suggested_reply\": \"Only if reply_needed is Yes, else leave as empty string\"\n}\n\nHere is the email body received:\n********************************\n\n{{ $json.text }}\n\n********************************"
            }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        848,
        336
      ],
      "id": "9d1a0037-e9fc-4922-a498-7dd782a8d51b",
      "name": "Summarize email and draft replies"
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"Email subject\": \"{{ $json.headers.subject }}\",\n  \"Email thread id\": \"{{ $json.threadId }}\",\n  \"Sender\": \"{{ $json.to.value[0].address }}\",\n  \"summary\": \"One sentence summary of the email\",\n  \"reply_needed\": \"Yes or No\",\n  \"suggested_reply\": \"Only if reply_needed is Yes, else leave as empty string\"\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        984,
        568
      ],
      "id": "8ca5a10c-ea06-40e5-a232-40f5cd40b383",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "resource": "draft",
        "subject": "={{ $('Gmail Trigger').item.json.subject }}",
        "emailType": "html",
        "message": "={{ $json.output.suggested_reply }}",
        "options": {
          "threadId": "={{ $('Gmail Trigger').item.json.threadId }}",
          "sendTo": "={{ $('Gmail Trigger').item.json.from.value[0].address }}"
        }
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        1424,
        240
      ],
      "id": "b2049ce4-a0c4-4ddd-a1c6-48519755c227",
      "name": "Create a draft"
    },
    {
      "parameters": {
        "operation": "sendAndWait",
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "message": "=New Email alert!\n\nSummary: {{ $('If reply is needed?').item.json.output.summary }}\n\nReply required: Yes\n\nSuggested reply:\n{{ $('If reply is needed?').item.json.output.suggested_reply }}\n\nWhats next?\n* Review or edit the draft reply in your Gmail\n* Or approve it by clicking [Approve & Disapprove] buttons below",
        "approvalOptions": {
          "values": {
            "approvalType": "double"
          }
        },
        "options": {}
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1648,
        240
      ],
      "id": "4f3604fa-c348-4ccf-9879-1cd7cfe3c207",
      "name": "Send message and wait for response"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.noOp",
