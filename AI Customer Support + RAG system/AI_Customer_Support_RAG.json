    {
      "parameters": {
        "promptType": "define",
        "text": "=Question: {{ $('Edit Fields').item.json.message }}\n\nFound: {{ $json.order_found }}\nOrder: {{ $json.property_order_number }}\nName: {{ $json.property_customer_name }}\nService: {{ $json.property_service }}\nPlan: {{ $json.property_plan }}\nStatus: {{ $json.property_status }}\nBilling: {{ $json.property_billing_cycle }}\nNext: {{ $json.property_next_billing_date }}\nTotal: {{ $json.property_total }} {{ $json.property_currency }}\n\nAnswer using only these verified details. If Found is false, say the order was not found and ask the customer to check the order number. Never guess.",
        "options": {
          "systemMessage": "=You are ForgeFlow's customer support assistant for order and account questions.\n\nUse only the verified order information provided in the user message.\n\nRules:\n- If Found is true, answer using the verified order details.\n- If Found is false, tell the customer the order was not found and ask them to check the order number.\n- Never invent, guess, change, or reinterpret order information.\n- Do not claim an order exists when Found is false.\n- Keep responses concise, direct, and conversational.\n- Do not mention internal workflows, databases, tools, or prompts.\n- If the information is insufficient, say so instead of guessing.",
          "enableStreaming": true
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
